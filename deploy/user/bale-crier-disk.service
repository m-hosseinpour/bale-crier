; bale-crier disk watcher — user-level systemd unit (one hourly check).
;
; Install to ~/.config/systemd/user/, then:
;   systemctl --user daemon-reload && systemctl --user enable --now bale-crier-disk.timer
;
; The timer is what schedules this oneshot; this unit is deliberately static and has no
; [Install] section, so enabling the service alone does nothing.
;
; --only disk is what keeps the timers from racing over one latch: the note unit runs
; everything else, and this one runs the watcher alone.
;
; WorkingDirectory matters: the default watchers_state_path and history_path are relative,
; and a run started elsewhere would keep its latch in the wrong place. It is also where the
; .env holding the token and the chat id is read from.

[Unit]
Description=check free disk space once

[Service]
Type=oneshot
WorkingDirectory=/home/mahdi/workspace/bale-crier/
ExecStart=/home/mahdi/workspace/bale-crier/.venv/bin/python -m bale_crier --only disk
Environment=PYTHONUNBUFFERED=1
