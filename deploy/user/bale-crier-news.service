; bale-crier news digest — user-level systemd unit (one daily digest).
;
; Install to ~/.config/systemd/user/, then:
;   systemctl --user daemon-reload && systemctl --user enable --now bale-crier-news.timer
;
; The timer is what schedules this oneshot; this unit is deliberately static and has no
; [Install] section, so enabling the service alone does nothing.
;
; --only news is what keeps the timers from racing over one seen set: the daily unit
; runs everything else, and this one runs the digest alone.
;
; WorkingDirectory matters: the default watchers_state_path and history_path are relative,
; and a run started elsewhere would keep its seen set in the wrong place. It is also where the
; .env holding the token, the chat id and CRIER_AVALAI_API_KEY is read from.
;
; Linger must be on — `sudo loginctl enable-linger $USER` — otherwise the user manager
; (and this timer with it) is torn down when the last session ends.
;
; TimeoutStartSec is raised well above systemd's 90-second default: a digest can wait out a feed
; fetch, a model call and a Bale send in turn, so the unit must allow more than
; CRIER_OPEN_AI_TIMEOUT plus the two CRIER_HTTP_TIMEOUT allowances. A run killed mid-wait would
; send nothing and leave no history line to say why, so keep this above their sum.

[Unit]
Description=send the AI-news digest once

[Service]
Type=oneshot
TimeoutStartSec=300
WorkingDirectory=/home/mahdi/workspace/bale-crier/
ExecStart=/home/mahdi/workspace/bale-crier/.venv/bin/python -m bale_crier --only news
Environment=PYTHONUNBUFFERED=1
