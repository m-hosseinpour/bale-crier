# Copy to .env and fill in. Every setting is read from the environment with the
# CRIER_ prefix; the two without a default are required.

# The bot whose token this is: @bale_crier_bot
CRIER_BALE_BOT_TOKEN=replace-with-the-bot-token
# The destination chat.
CRIER_BALE_CHAT_ID=0

# The owner's content, and the history the app keeps.
CRIER_LISTS_DIR=lists
CRIER_HISTORY_PATH=data/history.jsonl
CRIER_HISTORY_MAX_LINES=5000

# HTTP timeout for a Bale, credit or feed call, in seconds. The model has its own below.
CRIER_HTTP_TIMEOUT=30

# Send the smoke bulletin instead of the real ones. For the deploy check only.
CRIER_SMOKE=0

# The LLM that rewords a note and writes the news digest.
CRIER_OPEN_AI_BASE_URL=https://api.avalai.ir/v1
CRIER_OPEN_AI_MODEL=deepseek-v4-flash
# Left empty, it inherits CRIER_AVALAI_API_KEY below: one AvalAI key covers both.
CRIER_OPEN_AI_API_KEY=
# How long a model call may take, in seconds. It is a reasoning model and needs tens
# of seconds where a Bale call needs milliseconds, so it is not CRIER_HTTP_TIMEOUT.
CRIER_OPEN_AI_TIMEOUT=120

# What the AvalAI credit watcher reads (milestone 2).
CRIER_AVALAI_API_KEY=
# The credit threshold, in IRT: below it the watcher speaks, once per crossing.
CRIER_CREDIT_THRESHOLD_IRT=50000
# Where a watcher keeps its own memory — the latch. Separate from the history.
CRIER_WATCHERS_STATE_PATH=data/watchers.json
# How often an unreadable credit may speak, in hours.
CRIER_CREDIT_UNKNOWN_ALERT_HOURS=24
# How long before a weekly package that still holds money lapses the owner hears of it,
# in hours. The notice goes once per package, not every hour of the window.
CRIER_CREDIT_EXPIRY_WARNING_HOURS=24

# The disk watcher (milestone 5): free space under a threshold.
# Which filesystem to read. Everything on this machine is one mount at `/`.
CRIER_DISK_PATH=/
# The threshold in GiB, the unit the alert shows: below it the watcher speaks.
CRIER_DISK_THRESHOLD_GIB=2
# While space stays below the threshold, the reminder may repeat this often, in hours.
CRIER_DISK_REMINDER_HOURS=24

# The news digest (milestone 4): AI news three times a day, in groups of five stories.
# The feed is a Google News RSS search. Left empty, it is the owner's own query
# (written in bale_crier/news/feed.py); put a tightened query's URL here to change it.
CRIER_NEWS_FEED_URL=
# The most stories in one digest (at least 1).
CRIER_NEWS_MAX_ITEMS=10
# Stories per message (at least 1). Bale refuses a message over 4096 characters, so a
# group that would cross the 4000-character budget goes out as the next message instead.
CRIER_NEWS_BATCH_SIZE=5
# Comma-separated filter words; empty means the built-in default:
# funding, raises, valuation, lawsuit, ban, regulation, layoffs, earnings, iPhone,
# iOS, Android, gaming, laptop, laptops, GPU, driver, drivers, DLSS, Fitbit, Sims,
# Chrome, Netflix. The full reason is in README.md.
CRIER_NEWS_BLOCKLIST=

# The changedetection watcher (milestone 6): the pages changedetection.io watches.
# The port changedetection listens on — the loopback, not the public hostname, so Caddy
# and TLS are not on this path and a public outage cannot silence the watch.
CRIER_CHANGEDETECTION_URL=http://127.0.0.1:5005
# The API key changedetection shows in its own settings. Without it the watcher is not
# registered at all, since every read would be refused.
CRIER_CHANGEDETECTION_API_KEY=
# How often an unreadable API may speak, in hours.
CRIER_CHANGEDETECTION_UNKNOWN_ALERT_HOURS=24
